{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "agent-rules-mcp": {
        "type": "remote",
        "url": "https://YOUR-WORKER.workers.dev/mcp",
        "oauth": {
          "scope": "rules:read"
        }
      },
      "agent-rules-mcp-ci": {
        "type": "remote",
        "url": "https://YOUR-WORKER.workers.dev/mcp",
        "oauth": false,
        "disabled": true,
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/agent-rules-token.txt}"
        }
      }
    }
  }
}
