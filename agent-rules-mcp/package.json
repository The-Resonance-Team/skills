{
  "name": "agent-rules-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "bun scripts/build-catalog.ts",
    "build:check": "bun scripts/build-catalog.ts --check",
    "regenerate:draft": "bun scripts/regenerate-draft.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --check && bun test && vitest run",
    "eval": "bun eval/run.ts",
    "eval:check": "bun eval/run.ts --local",
    "lint": "oxlint --max-warnings=0",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "date-fns": "^4.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "latest",
    "@types/bun": "latest",
    "oxlint": "1.95.0",
    "slugify": "^1.6.9",
    "tiktoken": "^1.0.22",
    "typescript": "latest",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
